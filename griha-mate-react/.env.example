# Copy to .env.local and fill in real values. Never commit .env.local.
# Read by src/lib/config.ts.

# Backend API base URL (defaults to http://localhost:8081/api when unset)
VITE_API_URL=http://localhost:8081/api

# Gemini API keys for AI features. Keys _1 to _3 are tried in order as
# fallbacks; VITE_GEMINI_API_KEY is the legacy single-key fallback.
VITE_GEMINI_API_KEY_1=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=
VITE_GEMINI_API_KEY=
